#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, set = 0, rgba8) uniform writeonly image2D outputImage; // LDR world target image
layout(binding = 1, set = 0, rgba16f) uniform readonly image2D rtImage; // HDR RT radiance
layout(binding = 2, set = 0, r32f) uniform readonly image2D exposureImage; // 1x1 linear exposure scale
layout(binding = 3, set = 0, rgba16f) uniform writeonly image2D hdrImage; // PQ-encoded ([0,1], ST.2084) HDR display
layout(binding = 4, set = 0, r32f) uniform readonly image2D depthImage; // render-res reversed-Z guide

// HDR display parameters. hdrEnabled gates the parallel PQ write; the SDR AgX path always runs because
// vanilla main-target presentation still consumes LDR.
layout(push_constant) uniform Push {
    int hdrEnabled;        // 0 = SDR only, 1 = also write the PQ HDR image
    float paperWhiteNits;  // absolute nits SDR paper white maps to
    float headroom;        // highlight headroom above paper white (peakNits / paperWhiteNits, >= 1)
    int depthOfField;      // 0 = preserve the original display path
    float depthOfFieldStrength;
    int depthOfFieldQuality; // 0..5 = 8/16/32/48/80/120 samples
    int depthOfFieldMode;    // 0 = crosshair autofocus, 1 = distant miniature focus
    float depthOfFieldFocusDepth;
    float depthOfFieldFarDepth;
    int depthOfFieldForegroundQuality; // 0..5 = 4/8/16/24/64/120 spread samples
} pc;

// Tonemap seam: map HDR RT radiance to displayable LDR before copying back to the main target.
// The path tracer emits true HDR radiance, so exposure is applied from the compositor-owned 1x1 image
// before the AgX view transform. DLSS-RR still consumes HDR pre-tonemap.

const mat3 AGX_INSET = mat3(
    0.842479062253094, 0.042328242261012, 0.042375654905705,
    0.078433599999999, 0.878468636469772, 0.078433600000000,
    0.079223745147764, 0.079166127460543, 0.879142973793104
);

const mat3 AGX_OUTSET = mat3(
    1.196879005120170, -0.052896851757456, -0.052971635514443,
    -0.098020881140137, 1.151903129904170, -0.098043450117124,
    -0.099029744079720, -0.098961176844843, 1.151073672641160
);

const float AGX_MIN_EV = -12.47393;
const float AGX_MAX_EV = 4.026069;

vec3 agxDefaultContrast(vec3 x) {
    vec3 x2 = x * x;
    vec3 x4 = x2 * x2;
    return 15.5 * x4 * x2
        - 40.14 * x4 * x
        + 31.96 * x4
        - 6.868 * x2 * x
        + 0.4298 * x2
        + 0.1191 * x
        - 0.00232;
}

vec3 applyLook(vec3 color) {
    const float contrast = 1.04;   // try 1.15, 1.25, 1.4
    const float saturation = 1.05; // try 1.05-1.15 if AgX feels grey

    color = clamp((color - 0.5) * contrast + 0.5, 0.0, 1.0);

    float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
    color = mix(vec3(luma), color, saturation);

    return color;
}

vec3 agx(vec3 color) {
    color = AGX_INSET * max(color, vec3(0.0));
    color = clamp(log2(max(color, vec3(1.0e-10))), AGX_MIN_EV, AGX_MAX_EV);
    color = (color - AGX_MIN_EV) / (AGX_MAX_EV - AGX_MIN_EV);
    color = agxDefaultContrast(color);
    // color = applyLook(color);
    color = AGX_OUTSET * color;
    return clamp(color, 0.0, 1.0);
}

vec3 tonemap(vec3 hdr, float exposure) {
    return agx(hdr * exposure);
}

const float PQ_M1 = 0.1593017578125;
const float PQ_M2 = 78.84375;
const float PQ_C1 = 0.8359375;
const float PQ_C2 = 18.8515625;
const float PQ_C3 = 18.6875;

float pqEncode(float nits) {
    float y = pow(max(nits, 0.0) / 10000.0, PQ_M1);
    return pow((PQ_C1 + PQ_C2 * y) / (1.0 + PQ_C3 * y), PQ_M2);
}

// VK_COLOR_SPACE_HDR10_ST2084_EXT mandates BT.2020 primaries as its container gamut (not just the ST.2084
// transfer function) — but every color we compute (textures, tonemap) is authored/blended in BT.709/sRGB
// primaries. Feeding BT.709 numbers straight into a BT.2020-tagged buffer makes the display read them as
// (more saturated) BT.2020 coordinates, oversaturating everything. This matrix converts linear-light
// BT.709 -> BT.2020 right before the PQ encode, which is the container's actual gamut. (ITU-R BT.2087.)
const mat3 BT709_TO_BT2020 = mat3(
    0.6274039, 0.0690973, 0.0163916,
    0.3292830, 0.9195406, 0.0880132,
    0.0433131, 0.0113612, 0.8955953
);

// HDR display mapping: map exposed scene-linear radiance to absolute nits, then PQ-encode (ST.2084) for
// direct presentation to a PQ/HDR10 swapchain. SDR-range values (<= 1.0 after exposure) stay identity so
// paper white lands exactly at paperWhiteNits. Highlights above 1.0 roll off smoothly and asymptote to
// `headroom`, i.e. the brightest pixels approach peakNits. No SDR clamp here — that is the point.
vec3 tonemapHdr(vec3 hdr, float exposure) {
    vec3 c = max(hdr * exposure, vec3(0.0));
    vec3 lo = min(c, vec3(1.0));
    vec3 hi = max(c - vec3(1.0), vec3(0.0));
    float k = max(pc.headroom - 1.0, 0.0);
    vec3 rolled = (k > 0.0) ? (k * hi) / (k + hi) : vec3(0.0); // -> k as hi -> inf
    vec3 paperReferred = lo + rolled;                          // 1.0 == paper white, max -> headroom
    vec3 nits709 = paperReferred * pc.paperWhiteNits;
    vec3 nits2020 = BT709_TO_BT2020 * nits709;
    return vec3(pqEncode(nits2020.r), pqEncode(nits2020.g), pqEncode(nits2020.b));
}

float sceneDepth(ivec2 pixel, ivec2 displaySize) {
    ivec2 depthSize = imageSize(depthImage);
    ivec2 coord = clamp(pixel * depthSize / displaySize, ivec2(0), depthSize - 1);
    float depth = imageLoad(depthImage, coord).r;
    return isnan(depth) ? 0.0 : clamp(depth, 0.0, 1.0);
}

float autofocusDepth(ivec2 size) {
    ivec2 center = size / 2;
    ivec2 depthSize = imageSize(depthImage);
    // Use nearby depth pixels so one passing rain streak cannot pull the whole frame's focus.
    ivec2 spread = max(ivec2(4), (size * 3 + depthSize - 1) / depthSize);
    float a = sceneDepth(center + spread, size);
    float b = sceneDepth(center - spread, size);
    float c = sceneDepth(center + ivec2(spread.x, -spread.y), size);
    float d = sceneDepth(center + ivec2(-spread.x, spread.y), size);
    float centerDepth = sceneDepth(center, size);
    float lowerMiddle = max(min(a, b), min(c, d));
    float upperMiddle = min(max(a, b), max(c, d));
    return clamp(centerDepth, min(lowerMiddle, upperMiddle), max(lowerMiddle, upperMiddle));
}

float depthOfFieldRadius(float depth, float focusDepth, ivec2 size) {
    if (pc.depthOfFieldMode == 1) {
        // Projection depth is affine in inverse view distance. Removing its far limit makes
        // the ratio independent of the near plane. The bounded background CoC keeps very
        // distant scenery recognizable while closer defocused objects can blur more strongly.
        float focusInverseDistance = max(pc.depthOfFieldFocusDepth - pc.depthOfFieldFarDepth, 1.0e-6);
        float pixelInverseDistance = max(depth - pc.depthOfFieldFarDepth, 1.0e-6);
        float distanceRatio = pixelInverseDistance / focusInverseDistance;
        float maxRadius = distanceRatio > 1.0 ? 24.0 : 12.0;
        return min(maxRadius, abs(distanceRatio - 1.0) * 12.0) * pc.depthOfFieldStrength;
    }
    // Preserve the crosshair autofocus response.
    return min(14.0, abs(depth - focusDepth) * float(min(size.x, size.y)) * 0.42)
            * pc.depthOfFieldStrength;
}

vec3 blurSameDepthLayer(ivec2 pixel, ivec2 size, vec3 centerColor,
        float centerDepth, float radius) {
    if (radius < 0.8) return centerColor;
    int samples = pc.depthOfFieldQuality == 5 ? 120
            : (pc.depthOfFieldQuality == 4 ? 80
            : (pc.depthOfFieldQuality == 3 ? 48
            : (pc.depthOfFieldQuality == 2 ? 32 : (pc.depthOfFieldQuality == 0 ? 8 : 16))));
    int pairs = samples / 2;
    // A shared, opposite-pair spiral does not reshuffle at each screen pixel as the camera moves.
    // This trades fine-grained dithering for a more stable silhouette and balances every ring.
    vec2 direction = vec2(0.9800666, 0.1986693);
    vec3 sum = centerColor;
    float weightSum = 1.0;
    for (int i = 0; i < pairs; ++i) {
        float ring = sqrt((float(i) + 0.5) / float(pairs));
        ivec2 offset = ivec2(round(radius * ring * direction));
        for (int side = 0; side < 2; ++side) {
            ivec2 samplePixel = clamp(pixel + (side == 0 ? offset : -offset), ivec2(0), size - 1);
            float sampleDepth = sceneDepth(samplePixel, size);
            // The color was upscaled before this pass but the depth guide is still render-res.
            // Reject either direction of a large depth jump so a moving silhouette cannot
            // borrow unrelated foreground/background colors from sparse blur samples.
            float depthDifference = abs(sampleDepth - centerDepth);
            float relativeDifference = depthDifference
                    / max(max(sampleDepth, centerDepth) - pc.depthOfFieldFarDepth, 1.0e-5);
            float weight = 1.0 - smoothstep(0.10, 0.25, relativeDifference);
            sum += imageLoad(rtImage, samplePixel).rgb * weight;
            weightSum += weight;
        }
        direction = vec2(direction.x * -0.73736886 - direction.y * 0.67549032,
                direction.x * 0.67549032 + direction.y * -0.73736886);
    }
    return sum / weightSum;
}

vec3 applyDepthOfField(ivec2 pixel, ivec2 size, vec3 centerColor) {
    float focusDepth = pc.depthOfFieldMode == 1
            ? pc.depthOfFieldFocusDepth : autofocusDepth(size);
    float centerDepth = sceneDepth(pixel, size);
    float radius = depthOfFieldRadius(centerDepth, focusDepth, size);
    vec3 blurred = blurSameDepthLayer(pixel, size, centerColor, centerDepth, radius);

    // A nearer out-of-focus surface can cover this pixel even when the pixel itself is
    // sharp. Gather its circle of confusion separately, as ITRP's CoC-spread pass does.
    int spreadSamples = pc.depthOfFieldForegroundQuality == 5 ? 120
            : (pc.depthOfFieldForegroundQuality == 4 ? 64
            : (pc.depthOfFieldForegroundQuality == 3 ? 24
            : (pc.depthOfFieldForegroundQuality == 2 ? 16
            : (pc.depthOfFieldForegroundQuality == 0 ? 4 : 8))));
    int pairs = spreadSamples / 2;
    float searchRadius = (pc.depthOfFieldMode == 1 ? 24.0 : 14.0) * pc.depthOfFieldStrength;
    vec2 direction = vec2(0.8775826, 0.4794255);
    vec3 foregroundSum = vec3(0.0);
    float foregroundWeight = 0.0;
    for (int i = 0; i < pairs; ++i) {
        float distance = searchRadius * (float(i) + 0.5) / float(pairs);
        ivec2 offset = ivec2(round(distance * direction));
        for (int side = 0; side < 2; ++side) {
            ivec2 samplePixel = clamp(pixel + (side == 0 ? offset : -offset), ivec2(0), size - 1);
            float sampleDepth = sceneDepth(samplePixel, size);
            float separation = (sampleDepth - centerDepth)
                    / max(sampleDepth - pc.depthOfFieldFarDepth, 1.0e-5);
            if (separation > 0.18) {
                float sampleRadius = depthOfFieldRadius(sampleDepth, focusDepth, size);
                float coverage = smoothstep(0.0, 2.0, sampleRadius - length(vec2(offset)));
                foregroundSum += imageLoad(rtImage, samplePixel).rgb * coverage;
                foregroundWeight += coverage;
            }
        }
        direction = vec2(direction.x * -0.73736886 - direction.y * 0.67549032,
                direction.x * 0.67549032 + direction.y * -0.73736886);
    }
    float foregroundCoverage = min(0.75, 2.0 * foregroundWeight / float(spreadSamples));
    return mix(blurred, foregroundSum / max(foregroundWeight, 1.0e-5), foregroundCoverage);
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (pix.x >= size.x || pix.y >= size.y) {
        return;
    }

    vec4 rt = imageLoad(rtImage, pix);
    if (pc.depthOfField != 0 && pc.depthOfFieldStrength > 0.0) {
        rt.rgb = applyDepthOfField(pix, size, rt.rgb);
    }
    float exposure = max(imageLoad(exposureImage, ivec2(0)).r, 0.0);
    vec3 ldr = tonemap(rt.rgb, exposure);
    imageStore(outputImage, pix, vec4(ldr, 1.0));

    if (pc.hdrEnabled != 0) {
        imageStore(hdrImage, pix, vec4(tonemapHdr(rt.rgb, exposure), 1.0));
    }
}
