#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba32f) uniform readonly image2D currentImage;
layout(binding = 1, rgba32f) uniform image2D historyImage;
layout(binding = 2, rgba16f) uniform writeonly image2D resolvedImage;
layout(binding = 3, rgba32f) uniform image2D momentImage;

layout(push_constant) uniform Push {
    uint previousSamples;
    uint currentSamples;
    uint resetHistory;
} pc;

bool finiteMomentInput(vec3 value) {
    return !isnan(value.x) && !isinf(value.x) && !isnan(value.y) && !isinf(value.y)
            && !isnan(value.z) && !isinf(value.z);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(currentImage)))) {
        return;
    }

    vec4 current = imageLoad(currentImage, pixel);
    uint previous = pc.resetHistory != 0u ? 0u : pc.previousSamples;
    float total = float(previous + pc.currentSamples);
    vec4 average = previous == 0u
            ? current
            : (imageLoad(historyImage, pixel) * float(previous)
                    + current * float(pc.currentSamples)) / total;

    // Frame means are weighted by their SPP. Under independent samples with
    // Var(frameMean)=sigmaSquared/SPP, E[weighted M2]=(frameCount-1)*sigmaSquared.
    // Keep this auxiliary statistic separate: the raw mean above is unchanged.
    bool inputsValid = finiteMomentInput(current.rgb) && finiteMomentInput(average.rgb);
    vec4 moments = vec4(0.0, 0.0, 0.0, inputsValid ? 1.0 : -1.0);
    if (previous != 0u) {
        vec4 oldMoments = imageLoad(momentImage, pixel);
        vec3 oldMean = imageLoad(historyImage, pixel).rgb;
        vec3 delta = current.rgb - oldMean;
        vec3 updatedM2 = oldMoments.rgb + float(pc.currentSamples) * delta * (current.rgb - average.rgb);
        float count = oldMoments.w + 1.0;
        // Check before max: min/max behavior must not hide a NaN or negative infinity.
        bool finite = inputsValid && finiteMomentInput(oldMean) && finiteMomentInput(updatedM2);
        // Above the mean-weight cap the raw estimator is no longer an all-samples mean.
        bool valid = oldMoments.w > 0.0 && finite && pc.previousSamples < 16777208u;
        moments = valid ? vec4(max(vec3(0.0), updatedM2), count) : vec4(0.0, 0.0, 0.0, -1.0);
    }
    imageStore(momentImage, pixel, moments);
    imageStore(historyImage, pixel, average);
    imageStore(resolvedImage, pixel, average);
}
