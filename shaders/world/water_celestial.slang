// A direction proposal for a horizontal water exit; it never replaces geometry traversal.
import celestial;

public float waterCelestialGuideHalfAngle(float halfAngle) {
    // Keep the actual emitter strictly inside the proposal. In FP32, inverse Snell
    // and the traced refract() can disagree at the square edge by several ulps.
    return min(1.4, max(halfAngle, 1.0e-4) * 1.05);
}

public float3 waterCelestialDirection(float3 airDir, float eta) {
    if (!(airDir.y > 0.0)) return float3(0.0);
    float x = airDir.x / eta;
    float z = airDir.z / eta;
    return float3(x, sqrt(max(0.0, 1.0 - x * x - z * z)), z);
}

public float3 waterCelestialAirDirection(float3 waterDir, float eta) {
    if (!(waterDir.y > 0.0)) return float3(0.0);
    float x = waterDir.x * eta;
    float z = waterDir.z * eta;
    float cosSquared = 1.0 - x * x - z * z;
    if (!(cosSquared > 0.0)) return float3(0.0);
    return float3(x, sqrt(cosSquared), z);
}

public float waterCelestialJacobian(float airCos, float waterCos, float eta) {
    if (!(airCos > 0.0) || !(waterCos > 0.0)) return 0.0;
    // dOmegaAir / dOmegaWater from Snell's law, not a throughput eta correction.
    return eta * eta * waterCos / airCos;
}

public float waterCelestialPdf(float3 axis, float3 pole, float halfAngle,
                               float3 waterDir, float eta) {
    float3 airDir = waterCelestialAirDirection(waterDir, eta);
    if (!(airDir.y > 0.0)) return 0.0;
    float airPdf = celestialDirectionPdf(axis, pole, waterCelestialGuideHalfAngle(halfAngle), airDir);
    return airPdf * waterCelestialJacobian(airDir.y, waterDir.y, eta);
}

// Only for a direction just generated by sampleCelestialSquare + Snell mapping.
// Its proposal membership is known. Reconstructing and testing the square edge
// can round outside in FP32 and discard the entire selected component's density.
// Other strategies must still use waterCelestialPdf's support test.
public float waterCelestialSamplePdf(float3 axis, float3 pole, float halfAngle,
                                     float3 airDir, float3 waterDir, float eta) {
    float cosine = dot(normalize(axis), airDir);
    float t = celestialTangentHalfAngle(waterCelestialGuideHalfAngle(halfAngle));
    if (!(cosine > 0.0) || !(t > 0.0)) return 0.0;
    float airPdf = 1.0 / (4.0 * t * t * cosine * cosine * cosine);
    return airPdf * waterCelestialJacobian(airDir.y, waterDir.y, eta);
}

public float waterCelestialMixturePdf(float bsdfPdf, float guidePdf, float mix) {
    return (1.0 - mix) * bsdfPdf + mix * guidePdf;
}

public float waterCelestialGuideMix(bool submerged, float halfAngle, float elevation, float strength) {
    // Avoid inverse-Snell cancellation close to the critical angle. The ordinary
    // BSDF sampler remains active when this conservative proposal is unsuitable.
    float horizonMargin = 0.1 + 2.0 * tan(waterCelestialGuideHalfAngle(halfAngle));
    return submerged && halfAngle > 0.0 && elevation > horizonMargin && strength > 0.0 ? 0.5 : 0.0;
}

public bool waterCelestialProtectLeg(bool selectedGuide, float mix, float guidePdf) {
    // Both mixture components can produce the same low-throughput solar direction.
    // Protect its eventual bright contribution regardless of which component won.
    return selectedGuide || (mix > 0.0 && guidePdf > 0.0);
}
